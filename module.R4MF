R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=R4SRV
VERSION=0.1.2
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=service
TARGET=/R4OS/SERVICES/R4SRV.R4X
IMAGE_SCOPE=slim
IMPORT=R4SYS:Query2:2
IMPORT=R4NET:Query2:2
IMPORT=R4DEV:Query2:2
META=service.name=R4SRV
